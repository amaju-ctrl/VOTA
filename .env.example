# WhatsApp Cloud API credentials; configure as Space Secrets, not committed values.
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_API_VERSION=v21.0

# Optional: Meta Llama API. Without a key the app uses deterministic local templates.
LLAMA_API_KEY=
LLAMA_API_URL=https://api.llama.com/v1/chat/completions
LLAMA_MODEL=Llama-4-Scout-17B-16E-Instruct

INEC_CSV_PATH=data/polling_units.csv
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Optional Piper model filenames under PIPER_VOICE_DIR. JSON language keys.
# Supply available voice model(s) and matching .onnx.json config files yourself.
PIPER_VOICE_DIR=voices
PIPER_VOICE_MAP={"english":"en_US-lessac-medium.onnx"}
